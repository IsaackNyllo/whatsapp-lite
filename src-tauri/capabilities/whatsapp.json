{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "whatsapp-page",
  "description": "O que a página do WhatsApp Web (scripts injetados) pode pedir ao app: botões da barra de título e os comandos que os scripts chamam",
  "windows": ["main"],
  "remote": { "urls": ["https://web.whatsapp.com/*"] },
  "permissions": [
    "core:window:allow-set-always-on-top",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-start-dragging",
    "core:window:allow-close",
    "core:window:allow-unmaximize",
    "core:window:allow-set-size",
    "allow-bubble-enter",
    "allow-bubble-open",
    "allow-bubble-message",
    "allow-bubble-notice",
    "allow-bubble-unread",
    "allow-bubble-opts-set",
    "allow-lite-get",
    "allow-lite-set",
    "allow-lite-popup-style",
    "allow-lite-notice-pos",
    "allow-mcp-result",
    "allow-mcp-conexao",
    "allow-mcp-copiar",
    "allow-filtro-verificar",
    "allow-filtro-fila",
    "allow-filtro-get",
    "allow-filtro-acao",
    "allow-filtro-minhas",
    "allow-filtro-ollama"
  ]
}

{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Bolinha (conteúdo local de bubble/): mover, redimensionar e arrastar a própria janela, e os comandos dela",
  "windows": ["bubble"],
  "permissions": [
    "core:window:allow-set-position",
    "core:window:allow-set-size",
    "core:window:allow-start-dragging",
    "allow-bubble-open",
    "allow-bubble-reply",
    "allow-bubble-ready",
    "allow-bubble-opts-get",
    "allow-bubble-opts-set"
  ]
}
